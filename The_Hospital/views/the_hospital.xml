<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hospital_view_tree" model="ir.ui.view">
        <field name="name">hospital tree</field>
        <field name="model">hospital</field>
        <field name="arch" type="xml">
            <list>
                <field name="patient_name"/>
                <field name="ref"/>
                <field name="age"/> 
            </list>
        </field>
    </record>

    <record id="hospital_view_form" model="ir.ui.view">
        <field name="name">hospital form</field>
        <field name="model">hospital</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="ref"/>
                            <h1>
                                <field name="ref"/>
                            </h1>
                        <label for="patient_name"/>
                            <h3>
                                <field name="patient_name"/>
                            </h3>
                    </div>
                    <group>
                        <group>
                            <field name="age"/>
                            <field name="disease_ids" widget="many2many_tags"/>
                        </group>
                        <group>           
                            <h5><field name="signature" /></h5>
                            <!-- <field name="cure_ids" widget="many2many_tags"/> -->
                        </group>
                    </group>
                    <notebook>
                        <page string="Cure">
                            <field name="cure_ids">
                                <list>
                                        <field name="name_cure"/>
                                        <field name="company_name"/>
                                        <field name="medication_time"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                
            </form>
        </field>
    </record>
    <record id="hospital_action" model="ir.actions.act_window">
        <field name="name">The Hospital</field>
        <field name="res_model">hospital</field>

    </record>
    <menuitem
        id="hospital_ment_item"
        name="The Hospital"
        action="hospital_action"
        parent="hospital_menu"
        />


</odoo>